# ── Ollama ──────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# ── Storage ─────────────────────────────────────────────────────
DATA_DIR=data
# Chroma collection name (change if you want multiple isolated DBs)
CHROMA_COLLECTION=localrag

# ── Retrieval ───────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# ── Whisper (audio transcription) ───────────────────────────────
# Options: tiny, base, small, medium, large-v2
WHISPER_MODEL=small

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Cloud LLM (opt-in, default OFF) ─────────────────────────────
# Set USE_CLOUD_LLM=true to use an Anthropic Claude model instead of Ollama.
# Embedding always uses local Ollama regardless of this setting.
USE_CLOUD_LLM=false
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUD_LLM_MODEL=claude-3-5-sonnet-20241022
